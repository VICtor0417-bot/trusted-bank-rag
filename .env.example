# Copy to .env and load with python -m dotenv -f .env run -- ... (see README).
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
RAG_RETRIEVAL_MODE=bm25
RAG_ORCHESTRATOR=langgraph
RAG_ENABLE_LLM_PLANNER=0
RAG_REUSE_INITIAL_GLOBAL=0
RAG_ENABLE_JEV=0
TYPESAFE_API_KEY=
RAG_JEV_MODEL=jev-1.13.0
RAG_JEV_TIMEOUT=45
# Own corpus: see README. Synthetic demo uses its separate data/demo directory.
KNOWLEDGE_PATH=data/generated/knowledge.jsonl
